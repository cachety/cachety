{
  "id": "/",
  "name": "Cachety",
  "short_name": "Cachety",
  "description": "Watermark your ID and documents without them ever leaving your device. Free and open source.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f2f3f0",
  "theme_color": "#1a1e33",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  }
}
