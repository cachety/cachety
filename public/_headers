# Preuve technique de la promesse « zéro transfert » :
# connect-src 'self' interdit toute requête vers un domaine externe.
# 'unsafe-inline' (script-src) est un gabarit : scripts/gen-sw.mjs le
# remplace au build par les hachages sha256 des scripts inline émis, et
# recopie la même politique en <meta> dans chaque page HTML (défense en
# profondeur pour qui auto-héberge sans ce fichier).
# Détail et justification de chaque en-tête : docs/security.md.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), serial=(), hid=(), bluetooth=(), payment=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Le service worker doit être revalidé à chaque visite : un correctif de
# sécurité se propage alors dès le chargement suivant.
/sw.js
  Cache-Control: no-cache

# Copies du site sur d'autres noms d'hôte : hors index, l'original est
# https://cachety.com (balises canonical et sitemap.xml y pointent déjà).
# www doit en plus rediriger vers l'apex (règle Cloudflare, docs/deploy.md).
https://www.cachety.com/*
  X-Robots-Tag: noindex
https://cachety.pages.dev/*
  X-Robots-Tag: noindex
